{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard.local/schemas/guard-rules/v1.json",
  "title": "Guard rule set",
  "description": "Declarative pre-trade policy evaluated by the gateway before every order leaves the machine. Rules are evaluated in listed order; the first non-allow verdict wins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "on_violation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$",
          "description": "Stable identifier used in audit records."
        },
        "type": {
          "enum": [
            "symbol_allowlist",
            "exchange_allowlist",
            "max_notional",
            "max_leverage",
            "daily_loss_limit",
            "duplicate_suppression",
            "price_deviation",
            "trading_hours"
          ]
        },
        "on_violation": {
          "enum": ["reject", "flatten", "halt"],
          "description": "reject = drop the order; flatten = close the position and drop; halt = freeze the account until manually re-enabled."
        },
        "enabled": { "type": "boolean", "default": true },
        "description": { "type": "string", "maxLength": 280 },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "symbol_allowlist" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["symbols"], "properties": { "symbols": { "type": "array", "items": { "type": "string" } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "exchange_allowlist" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["exchanges"], "properties": { "exchanges": { "type": "array", "items": { "enum": ["binance", "bybit", "okx"] } } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "max_notional" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["max_usd"], "properties": { "max_usd": { "type": "number", "exclusiveMinimum": 0 }, "window": { "enum": ["order", "day", "position"] } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "max_leverage" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["max_x"], "properties": { "max_x": { "type": "number", "minimum": 1, "maximum": 125 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "daily_loss_limit" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["max_loss_pct"], "properties": { "max_loss_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "duplicate_suppression" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["window_seconds"], "properties": { "window_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "price_deviation" } }, "required": ["type"] },
          "then": { "properties": { "params": { "required": ["max_pct"], "properties": { "max_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.2 } } } } }
        }
      ]
    }
  }
}
